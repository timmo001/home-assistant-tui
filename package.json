{
  "name": "home-assistant-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/home-assistant-tui",
    "typecheck": "tsc --noEmit",
    "ci": "bun run format:check && bun run typecheck && bun run build",
    "gen:icons": "bun run scripts/gen-mdi-codepoints.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@opentui/core": "^0.2.7",
    "effect": "^4.0.0-beta.66",
    "fuse.js": "^7.3.0",
    "home-assistant-js-websocket": "^9.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prettier": "^3.5.3",
    "typescript": "^6.0.0"
  }
}
