{
  "name": "home-assistant-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/home-assistant-tui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run build",
    "gen:icons": "bun run scripts/gen-mdi-codepoints.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@opentui/core": "^0.4.0",
    "effect": "4.0.0-rc.117",
    "fuse.js": "^7.3.0",
    "home-assistant-js-websocket": "^9.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.45.0",
    "@oxlint/plugins": "1.85.0",
    "@timmo001/oxlint-rules": "0.3.6",
    "@types/bun": "^1.3.13",
    "oxlint": "1.85.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.0"
  }
}
