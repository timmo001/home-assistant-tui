#!/bin/sh

pkgname=home-assistant-tui
pkgver=${ARCH_PKGVER}
pkgrel=1
pkgdesc="Terminal UI for Home Assistant"
source=('home-assistant-tui' 'LICENSE')
arch=('x86_64' 'aarch64')
url="https://github.com/timmo001/home-assistant-tui"
license=('Apache-2.0')
provides=('home-assistant-tui')
conflicts=('home-assistant-tui-git')
options=('!strip')
replaces=('home-assistant-tui-git')

build() {
  :
}

package() {
  install -Dm755 home-assistant-tui "$pkgdir/usr/bin/home-assistant-tui"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
