{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "Update the Effect runtime and integrations together.",
      "matchPackageNames": ["effect", "@effect/platform-*", "@effect/vitest"],
      "groupName": "Effect",
      "groupSlug": "effect"
    },
    {
      "description": "Use the shorter release delay for Effect dependencies.",
      "matchPackageNames": [
        "effect",
        "@effect/platform-*",
        "@effect/vitest",
        "@effect/tsgo"
      ],
      "minimumReleaseAge": "2 hours"
    },
    {
      "description": "Update first-party dependencies without a release delay.",
      "matchPackageNames": [
        "@timmo001/**",
        "timmo001/**",
        "https://github.com/timmo001/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": ["effect"],
      "ignoreUnstable": false
    }
  ]
}
